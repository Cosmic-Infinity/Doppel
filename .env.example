# Doppel environment overrides. Copy to .env and adjust as needed.
# Values here override config.yaml. Nested settings use a double underscore:
#   DOPPEL_<SECTION>__<KEY>   e.g. DOPPEL_LLM__BASE_URL sets llm.base_url

# Network & SSH
DOPPEL_HONEYPOT__HOST=0.0.0.0
DOPPEL_HONEYPOT__PORT=2222
DOPPEL_HONEYPOT__HOST_KEY_DIR=.

# LLM backend (remote GPU machine over Tailscale, or local)
DOPPEL_LLM__BASE_URL=http://100.x.y.z:11434/v1
DOPPEL_LLM__MODEL=qwen2.5-coder:7b
DOPPEL_LLM__API_KEY=ollama
DOPPEL_LLM__TIMEOUT_SECONDS=45.0
DOPPEL_LLM__MOCK_MODE=false

# Deception
DOPPEL_ACTIVE_PRESET=ubuntu_web_server
DOPPEL_DECEPTION__TAR_PIT_DELAY_MS=0
# Public address of the HTTP decoy, used in leaked canary URLs
DOPPEL_DECEPTION__CANARY_BASE_URL=

# Sandbox (Docker)
DOPPEL_SANDBOX__ENABLED=true
DOPPEL_SANDBOX__IMAGE=doppel-sandbox:ubuntu-22.04
DOPPEL_SANDBOX__NETWORK_DISABLED=true

# HTTP decoy (0 disables it)
DOPPEL_HTTP_SENSOR_PORT=8080

# Database & reports
DOPPEL_ANALYTICS__DB_PATH=doppel_telemetry.db
DOPPEL_ANALYTICS__REPORTS_DIR=reports
