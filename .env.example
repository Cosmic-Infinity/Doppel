# Doppel Environment Variables
# Copy to .env and adjust as needed

# Network & SSH
DOPPEL_HONEYPOT_HOST=0.0.0.0
DOPPEL_HONEYPOT_PORT=2222
DOPPEL_HOSTNAME=prod-api-node-01

# LLM Backend (Remote A2000 machine over Tailscale or local)
DOPPEL_LLM_BASE_URL=http://100.x.y.z:11434/v1
DOPPEL_LLM_MODEL=qwen2.5-coder:7b
DOPPEL_LLM_API_KEY=ollama
DOPPEL_LLM_TIMEOUT=15.0
DOPPEL_LLM_MOCK_MODE=false

# Deception & Persona
DOPPEL_PERSONA=ubuntu_web_server
DOPPEL_TAR_PIT_DELAY_MS=0

# Sandbox (Docker)
DOPPEL_SANDBOX_ENABLED=true
DOPPEL_SANDBOX_IMAGE=alpine:latest
DOPPEL_SANDBOX_NETWORK_DISABLED=true

# Database & Telemetry
DOPPEL_DB_PATH=doppel_telemetry.db
